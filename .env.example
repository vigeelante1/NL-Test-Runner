# Copy this file to ".env" and fill in your key. ".env" is git-ignored: never commit it.
GEMINI_API_KEY=paste-your-key-here

# Optional. Flash-Lite allows ~500 requests/day on the free tier (Flash: ~20).
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds between AI calls (the free tier allows ~10 requests/minute)
GEMINI_MIN_INTERVAL=6
NLQA_MAX_STEPS=25
